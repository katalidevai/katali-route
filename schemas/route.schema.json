{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Katali-Route decision",
  "type": "object",
  "required": ["request_id", "action", "confidence"],
  "properties": {
    "request_id": {"type": "string"},
    "action": {"enum": ["generate", "retry", "escalate", "bypass"]},
    "model_id": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "validate_output": {"type": "boolean"},
    "retry_budget": {"type": "integer", "minimum": 0},
    "rationale": {"type": "array", "items": {"type": "string"}},
    "selected_tools": {"type": "array", "items": {"type": "string"}}
  }
}
